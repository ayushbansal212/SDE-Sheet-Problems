................................ RECURSION ...........................................
class Solution {
    private final int MOD = (int)(1e9) + 7;
    public int perfectSum(int[] arr, int target) {

        return count(0, arr, target);
    }

    public int count(int idx, int arr[], int target){
        if(target == 0){
            return 1;
        }

        if(idx == arr.length){
            return 0;
        }

        int notTaken = count(idx + 1, arr, target) % MOD;
        int taken = 0;

        if(target >= arr[idx]){
            taken = count(idx + 1, arr, target - arr[idx]) % MOD;
        }

        return (taken + notTaken) % MOD;
    }

    // TC :- O(2 ^ n) -- > n is size of array
    // SC :- O(n) --> stack space
}



.................................. MEMOIZATION ...........................................

class Solution {
    private final int MOD = (int)(1e9) + 7;
    public int perfectSum(int[] arr, int target) {
        int dp[][] = new int[arr.length + 1][target + 1];

        for(int a[] : dp){
            Arrays.fill(a, -1);
        }
        return count(0, arr, target, dp);
    }

    public int count(int idx, int arr[], int target, int dp[][]){
        if(target == 0){
            // dp[idx][target] = 1;
            return 1;
        }

        if(idx == arr.length){
            return 0;
        }

        if(dp[idx][target] != -1){
            return dp[idx][target];
        }

        int notTaken = count(idx + 1, arr, target, dp) % MOD;
        int taken = 0;

        if(target >= arr[idx]){
            taken = count(idx + 1, arr, target - arr[idx], dp) % MOD;
        }

        return dp[idx][target] = (taken + notTaken) % MOD;
    }

    TC :- O(n * target) -- > n is size of array 
    SC :- O(n) --> stack space + O(n * target) dp space
}

// .................................... TABULATION ...........................................
class Solution {
    private final int MOD = (int)(1e9) + 7;
    public int perfectSum(int[] arr, int target) {
        int dp[][] = new int[arr.length + 1][target + 1];
        for(int i = 0 ; i < dp.length; i++){
            dp[i][0] = 1;
        }

        for(int i = 1; i <= target; i++){
            dp[arr.length][i] = 0;
        }

        for(int idx = arr.length - 1; idx >= 0; idx --){
            for(int j = 0; j <= target; j++){

                int notTaken = dp[idx + 1][j] % MOD;
                int taken = 0;

                if(j >= arr[idx]){
                    taken = (dp[idx + 1][j - arr[idx]]) % MOD;
                }

                dp[idx][j] = (taken + notTaken) % MOD;
            }
        }

        return dp[0][target];
    }
}

// TC :- O(n * target) -- > n is size of array 
// SC :- O(n * target) dp space
    

// .......................................... SPACE OPTIMIZATION ..........................................
class Solution {
    private final int MOD = (int)(1e9) + 7;
    public int perfectSum(int[] arr, int target) {
        int dp[] = new int[target + 1];
        dp[0] = 1;

        for(int idx = arr.length - 1; idx >= 0; idx --){
            int newDp[] = new int[target + 1];
            for(int j = 0; j <= target; j++){

                int notTaken = dp[j] % MOD;
                int taken = 0;

                if(j >= arr[idx]){
                    taken = dp[j - arr[idx]] % MOD;
                }

                newDp[j] = (taken + notTaken) % MOD ;
            }
            dp = newDp;
        }

        return dp[target];
    }
}

// TC :- O(n * target) -- > n is size of array 
// SC :- O(target) dp space
    